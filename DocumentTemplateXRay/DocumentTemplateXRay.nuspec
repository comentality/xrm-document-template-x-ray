<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2012/06/nuspec.xsd">
  <metadata>
    <id>DocumentTemplateXRay</id>
    <version>1.2.20</version>
    <title>Document Template XRay</title>
    <authors>Comentality</authors>
    <license type="expression">MIT</license>
    <projectUrl>https://github.com/comentality/xrm-document-template-x-ray</projectUrl>
    <repository type="git" url="https://github.com/comentality/xrm-document-template-x-ray.git" branch="main" />
    <icon>icon.png</icon>
    <readme>docs\README.md</readme>
    <description>Extract Dynamics 365 field references from Word document templates (XRay). Analyzes DOCX templates to reveal all entity fields, conditions, and relationships used.</description>
    <releaseNotes>v1.2.20 - Rename to "Document Template XRay". The hyphen in "X-Ray" meant a search for "xray" in the XrmToolBox tools list did not match this tool.</releaseNotes>
    <tags>XrmToolBox Dynamics365 CRM DocumentTemplate PowerPlatform XRay</tags>
    <dependencies>
      <group targetFramework=".NETFramework4.8">
        <dependency id="XrmToolBox" version="1.2025.7.71" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\Release\net48\DocumentTemplateXRay.dll" target="Plugins\DocumentTemplateXRay.dll" />
    <file src="icon.png" target="icon.png" />
    <file src="..\README.md" target="docs\README.md" />
  </files>
</package>
