<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <!-- A console app that opens windows: the findings go to stdout, and the windows are what
         the findings are about. -->
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sample environment and the window capture. -->
    <Compile Include="..\harness\*.cs" LinkBase="Harness" />
    <!-- The templates the fake environment serves are the fixtures, as real bytes: the tool
         unzips and parses them with the extractor it ships. -->
    <Content Include="..\..\fixtures\*.docx" Link="fixtures\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sample.cs builds a .docx, which is a zip; the tool references these for the same reason. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DocumentTemplateXRay\DocumentTemplateXRay.csproj" />
    <!-- The tool project keeps this package private, so the harness needs its own reference to
         compile against PluginControlBase, the base class of the control it hosts. -->
    <PackageReference Include="XrmToolBoxPackage" Version="1.2025.7.71">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
</Project>
